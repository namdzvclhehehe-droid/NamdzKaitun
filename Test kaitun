FunctionsHandler.LocalPlayerController:RegisterMethod("EquipTool", function(toolName)
    if not Humanoid then return end
    local bp = LocalPlayer:FindFirstChild("Backpack"); if not bp then return end
    for _, v in bp:GetChildren() do
        if v:IsA("Tool") and v.Name ~= "Tool" and (v.Name == tostring(toolName) or v.ToolTip == toolName) then
            LocalPlayer.Character:WaitForChild("Humanoid"):EquipTool(v)
        end
    end
end)

