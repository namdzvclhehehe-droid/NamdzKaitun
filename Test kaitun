function CombatController.Search(names)
    local candidates, anyFound = {}, false
    for _, e in GetMonAsSortedRange() do
        if table.find(names, e.Name) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
            if (e:GetAttribute("FailureCount") or 0) < 3 then
                anyFound = true; table.insert(candidates, e)
            end
        end
    end
    if not anyFound then
        for _, n in names do
            local npc = game.ReplicatedStorage:FindFirstChild(n)
            if npc then return npc end
        end
        return nil
    end
    table.sort(candidates, function(a,b)
        local function dist(x) return x and x:FindFirstChild("HumanoidRootPart") and math.floor(CaculateDistance(x.HumanoidRootPart.CFrame)) end
        return (dist(a) or 0) < (dist(b) or 0)
    end)
    return candidates[1]
end

