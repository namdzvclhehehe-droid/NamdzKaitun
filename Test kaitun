    for _, m in ipairs(MASTERY_TRAIN_ORDER) do if m.name==trainingName then target=m.target; break end end
    if mastery >= target then SetTask("SubTask","✅ "..trainingName.." đạt mastery"); return end
    pcall(function() FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call(trainingName) end)
    local cakeLoaf = workspace.Map:FindFirstChild("CakeLoaf")
    if not cakeLoaf then
        SetTask("MainTask","Cake Mastery | Di chuyển tới đảo Cake")
        TweenController.Create(CAKE_AREA_CF); return
    end
    local boss = workspace.Enemies:FindFirstChild("Cake Prince")
    if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
        SetTask("MainTask","Cake Mastery | "..trainingName.." ("..mastery.."/"..target..")")
        TweenController.Create(boss.HumanoidRootPart.CFrame+Vector3.new(0,30,0))
        CombatController.Attack("Cake Prince")
        pcall(function()
            if boss.Parent==nil or boss.Humanoid.Health<=0 then
                if ConfirmBossDead("Cake Prince") then
                    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if h then h.Health=0; LocalPlayer.CharacterAdded:Wait() end
                end
            end
        end)
    else
        local mob = nil
        for _, mn in ipairs(CAKE_UNLOCK_MOBS) do
            local m = workspace.Enemies:FindFirstChild(mn)
            if m and m:FindFirstChild("Humanoid") and m.Humanoid.Health>0 then mob=m; break end
        end
        if mob then
            TweenController.Create(mob.HumanoidRootPart.CFrame+Vector3.new(0,5,0))
            CombatController.Attack(CAKE_UNLOCK_MOBS)
        else
            TweenController.Create(CAKE_AREA_CF)
        end
    end
end)

