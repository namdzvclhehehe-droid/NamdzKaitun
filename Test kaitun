FunctionsHandler.LevelFarm:RegisterMethod("Start", function(step)
    local lv = ScriptStorage.PlayerData.Level or 0
    if lv >= 700 and SeaIndex == 1 then return end
    if step == 2 then
        SetTask("MainTask", "Level Farm | Shanda | Upper Skylands")
        local found = false
        for _, folder in ipairs({workspace.Enemies, game.ReplicatedStorage}) do
            for _, v in ipairs(folder:GetChildren()) do
                if v.Name=="Shanda" and v:IsA("Model") then
                    local h = v:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        found = true; SetTask("SubTask","⚔️ Shanda"); CombatController.Attack("Shanda"); break
                    end
                end
            end
            if found then break end
        end
        if not found then
            local sp = game.ReplicatedStorage.FortBuilderReplicatedSpawnPositionsFolder
            local n  = sp and sp:FindFirstChild("Shanda")
            if n then TweenController.Create(n:GetPivot()+Vector3.new(0,25,0))
            else TweenController.Create(CFrame.new(-7783,5576,-519)) end
        end
    elseif step == 3 then
        SetTask("MainTask", "Level Farm | God's Guard | Skylands")
        local found = false
        for _, folder in ipairs({workspace.Enemies, game.ReplicatedStorage}) do
            for _, v in ipairs(folder:GetChildren()) do
                if v.Name=="God's Guard" and v:IsA("Model") then
                    local h = v:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        found = true; SetTask("SubTask","⚔️ God's Guard"); CombatController.Attack("God's Guard"); break
                    end
                end
            end
            if found then break end
        end
        if not found then
            local n = game.ReplicatedStorage.FortBuilderReplicatedSpawnPositionsFolder:FindFirstChild("God's Guard")
            if n then TweenController.Create(n:GetPivot()+Vector3.new(0,25,0)) end
        end
    else
        local Q = ManualLevelLookup()
        if not Q then return end
        SetTask("SubTask","📋 "..Q.NameMon.." | Quest: "..Q.Mon)
        local aqn = GetActiveQuestName()
        if aqn ~= nil then
            if aqn ~= false then
                if aqn ~= Q.Qname then return J.AbandonQuest() end
            else
                TweenController.Create(Q.PosQ + Vector3.new(0,5,3))
                SetTask("MainTask","Level Farm | "..Q.Mon.." | Nhận Quest")
                if CaculateDistance(Q.PosQ) > 10 then return end
                task.wait(0.5); J.StartQuest(Q.Qname, Q.Qdata); task.wait(0.3)
            end
        else
            local cq = GetCurrentClaimQuest()
            if cq then
                if cq ~= Q.NameMon and cq ~= (Q.NameMon.."s") then return J.AbandonQuest() end
            else
                TweenController.Create(Q.PosQ + Vector3.new(0,5,3))
                SetTask("MainTask","Level Farm | "..Q.Mon.." | Nhận Quest")
                if CaculateDistance(Q.PosQ) > 10 then return end
                task.wait(0.5); J.StartQuest(Q.Qname, Q.Qdata); task.wait(0.3)
            end
        end
        CombatController.Attack(Q.Mon)
    end
end)

