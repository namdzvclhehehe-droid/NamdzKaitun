function TweenController.Create(target)
    if not target or TweenDebounce then return end
    local cf = typeof(target) ~= "CFrame" and ConvertTo(CFrame, target) or target
    if TweenInstance then pcall(function() TweenInstance:Cancel() end) end
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    local head = char:WaitForChild("Head")
    if not head:FindFirstChild("eltrul") then
        local bv = Instance.new("BodyVelocity")
        bv.Name     = "eltrul"
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Velocity = Vector3.zero
        bv.Parent   = head
    end
    cf = CFrame.new(cf.Position)
    local dist = CaculateDistance(hrp.CFrame, cf)
    if dist <= 5 then hrp.CFrame = cf; block.CFrame = cf; return end
    local duration = dist / 160
    shouldTween = true
    TweenInstance = Services.TweenService:Create(block, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame=cf})
    TweenInstance:Play()
    task.spawn(function()
        while TweenInstance and TweenInstance.PlaybackState == Enum.PlaybackState.Playing do
            if not shouldTween then pcall(function() TweenInstance:Cancel() end); break end
            task.wait(0.1)
        end
        shouldTween = false
    end)
end

function TweenController.Update()
    local a = LocalPlayer.Character.HumanoidRootPart
    HumanoidRootPart = LocalPlayer.Character:WaitForChild("HumanoidRootPart")
    if CaculateDistance(a.CFrame) > 250 then
        pcall(function() TweenInstance:Cancel() end)
        TweenDebounce = true; a.CFrame = HumanoidRootPart.CFrame; TweenDebounce = false
    end
    HumanoidRootPart.CFrame = a.CFrame + Vector3.new(0,3,0)
end

