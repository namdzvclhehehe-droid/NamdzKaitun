function DispTime(W, a)
    W = tonumber(W); if not W then return "[err]" end
    local h = math.floor(W/86400)
    local X = math.floor(math.fmod(W,86400)/3600)
    local w = math.floor(math.fmod(W,3600)/60)
    local D = math.floor(math.fmod(W,60))
    if a then return h.."day, "..X.."hrs, "..w.."min, "..D.."sec." end
    return h.."day, "..X.."hrs."
end
function GetCurrentDateTime()
    local d = os.date("*t")
    local days = {"Sun","Mon","Tue","Wed","Thu","Fri","Sat"}
    local months = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}
    return string.format("%02d:%02d %s, %s %d %d", d.hour, d.min, days[d.wday], months[d.month], d.day, d.year)
end
function ConvertTo(tp, v) return tp.new(v.X, v.Y, v.Z) end
function CaculateDistance(a, b)
    if not a then return 0 end
    b = b or LocalPlayer.Character.HumanoidRootPart.CFrame
    return (ConvertTo(Vector3,a) - ConvertTo(Vector3,b)).Magnitude
end
function Split(str, sep)
    if sep == nil then sep = "%s" end
    local t = {}
    for s in string.gmatch(str, "([^"..sep.."]+)") do table.insert(t,s) end
    return t
end
function RoundVector3Down(v)
    return Vector3.new(math.floor(v.X/10)*10, math.floor(v.Y/10)*10, math.floor(v.Z/10)*10)
end
function CheckIsPlayerAlive(p)
    p = p or LocalPlayer
    return p and p.Character and p.Character.Humanoid and p.Character.HumanoidRootPart
        and p.Character.Head and p.Character.Humanoid.Health > 0
end
function FruitIdToName(id) local ok = string.match(id,"((%u)[^%-]+)$"); return ok.." Fruit" end
function FruitNameToId(n) local w = Split(n)[1]; return w.."-"..w end
function CheckItem(name)
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    for _, v in next, bp and bp:GetChildren() or {} do
        if v:IsA("Tool") and (v.Name==name or string.find(v.Name,name)) then return v end
    end
    if char then
        for _, v in next, char:GetChildren() do
            if v:IsA("Tool") and (v.Name==name or string.find(v.Name,name)) then return v end
        end
    end
    return false
end
function SendKey(key, hold)
    game:GetService("VirtualInputManager"):SendKeyEvent(true,  key, false, game)
    task.wait(hold)
    game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
end
function GetMonAsSortedRange()
    local t = {}
    for _, e in pairs(Services.Workspace.Enemies:GetChildren()) do
        if e and e:FindFirstChild("Humanoid") and e:FindFirstChild("HumanoidRootPart") and e.Humanoid.Health > 0 then
            table.insert(t, e)
        end
    end
    for _, e in pairs(game.ReplicatedStorage:GetChildren()) do
        if e and e:FindFirstChild("Humanoid") and e:FindFirstChild("HumanoidRootPart") and e.Humanoid.Health > 0 then
            table.insert(t, e)
        end
    end
    table.sort(t, function(a,b)
        return CaculateDistance(a.HumanoidRootPart.CFrame) < CaculateDistance(b.HumanoidRootPart.CFrame)
    end)
    return t
end

