local function GetQuestData(level)
    local pId = game.PlaceId
    local isBuddha = false
    pcall(function()
        if LocalPlayer.Data.DevilFruit.Value == "Buddha-Buddha" then isBuddha = true end
    end)

    if pId == 2753915549 then
        if level < 10 then return {Mob = "Bandit", QuestName = "BanditQuest1", QuestID = 1, Group = "Bandits", PosNPC = CFrame.new(1059.3, 15.4, 1550.4)}
        elseif level >= 10 and level < 30 then return {Mob = "Monkey", QuestName = "JungleQuest", QuestID = 1, Group = "Monkeys", PosNPC = CFrame.new(-1598.9, 36.9, 148.7)}
        elseif level >= 30 and level < 35 then return {Mob = "Gorilla", QuestName = "JungleQuest", QuestID = 2, Group = "Gorillas", PosNPC = CFrame.new(-1598.9, 36.9, 148.7)}
