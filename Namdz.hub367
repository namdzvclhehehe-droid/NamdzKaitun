task.spawn(function()
	while task.wait() do
		local t1 = TweenService:Create(UIStroke, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = Color3.fromRGB(255, 255, 180)})
		local t2 = TweenService:Create(TitleLabel, TweenInfo.new(1.2), {TextColor3 = Color3.fromRGB(255, 255, 180)})
		local t3 = TweenService:Create(StatusLabel, TweenInfo.new(1.2), {TextColor3 = Color3.fromRGB(255, 255, 180)})
		t1:Play() t2:Play() t3:Play() t1.Completed:Wait()
		
		local t4 = TweenService:Create(UIStroke, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = Color3.fromRGB(255, 200, 60)})
		local t5 = TweenService:Create(TitleLabel, TweenInfo.new(1.2), {TextColor3 = Color3.fromRGB(255, 200, 60)})
		local t6 = TweenService:Create(StatusLabel, TweenInfo.new(1.2), {TextColor3 = Color3.fromRGB(255, 200, 60)})
		t4:Play() t5:Play() t6:Play() t4.Completed:Wait()
	end
end)

local function UpdateUIStatus(text)
    StatusLabel.Text = "Status: " .. tostring(text)
end

-- ==========================================
-- ĐỊNH NGHĨA HÀM TỰ LÔI VŨ KHÍ RA TAY
-- ==========================================
local function AutoEquipMelee()
    local char = LocalPlayer.Character
    if not char then return end
    if not char:FindFirstChildOfClass("Tool") then
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool:FindFirstChild("Combat") or tool.Name:find("Leg") or tool.Name:find("Style")) then
                tool.Parent = char
                break
            end
        end
    end
end

-- ==========================================
-- BẢNG SỬA LỖI TỌA ĐỘ PHÂN TÍCH LEVEL (ĐÃ FIX KHÔNG BỊ THIẾU)
