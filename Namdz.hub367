-- [[ NAMDZ HUB KAITUN - MAXIMUM HYBRID WORKING VERSION ]] --

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("Status_UI") then CoreGui.Status_UI:Destroy() end

local IsScriptRunning = true
local MaxLevel = 2800

local Config = {
    FastAttack = true,
    BringMob = true,
    AutoStats = true,
    SaveFPS = true,
    AutoHaki = true,
    AutoBuyStyle = true,
    RemoteQuest = true -- Bật nhận nhiệm vụ từ xa bypass NPC
}

if Config.SaveFPS then
    setfpscap(30)
    game:GetService("Lighting").GlobalShadows = false
end

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
local CommF = Remotes and Remotes:WaitForChild("CommF_", 15)

